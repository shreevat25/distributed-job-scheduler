# PostgreSQL
POSTGRES_USER=djs_user
POSTGRES_PASSWORD=djs_password
POSTGRES_DB=djs_db

# Application Database URL (used by the API container)
DATABASE_URL=postgresql+asyncpg://djs_user:djs_password@localhost:5432/djs_db

# JWT
JWT_SECRET_KEY=change-me-in-production-use-a-strong-random-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Job Scheduling
JOB_LEASE_DURATION_SECONDS=30

# Logging
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=http://localhost:5173
